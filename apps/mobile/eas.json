{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://track.q9labs.ai"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://track.q9labs.ai"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://track.q9labs.ai"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "q9labs.ai@gmail.com",
        "ascAppId": "6763930104"
      },
      "android": {
        "track": "internal"
      }
    }
  }

{
  "name": "track",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test && vitest run --dir convex --environment node",
    "docs": "turbo run docs",
    "convex:dev": "convex dev",
    "convex:deploy:dev": "convex deploy",
    "convex:deploy:prod": "convex deploy --env-file convex.prod.env",
    "test:atlas": "playwright test scratchpad/track-atlas.spec.js --reporter=line"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.6.0",
    "@types/web-push": "^3.6.4",
    "convex": "^1.36.1",
    "convex-test": "0.0.53",
    "oxlint": "^1.61.0",
    "three": "^0.184.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.9",
    "@convex-dev/better-auth": "^0.12.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@openrouter/ai-sdk-provider": "^2.8.1",
    "@upstash/box": "0.4.4",
    "ai": "^6.0.168",
    "fflate": "0.8.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "web-push": "^3.6.7",
    "zod": "4.3.6"
  }
}
